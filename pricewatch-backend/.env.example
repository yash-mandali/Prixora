NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://yashmandali211:root@yashmandali.bddqxyr.mongodb.net/pricewatch
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# The scheduler runs inside the API by default outside production. Production uses a separate worker container.
WORKER_POLL_INTERVAL_MS=1000
MAX_CONCURRENT_JOBS=3
LEASE_MS=300000
JOB_TIMEOUT_MS=60000
DOMAIN_MIN_GAP_MS=3000
MAX_CONSECUTIVE_FAILURES=5

MIN_INTERVAL_MINUTES=15
MAX_TASKS_PER_USER=50
ALLOW_GENERIC_EXTRACTOR=true
ALLOW_PRIVATE_URLS=false
EXECUTION_TTL_DAYS=90

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NO_SANDBOX=false

# Optional email (leave SMTP_HOST empty to disable email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PriceWatch <no-reply@example.com>
